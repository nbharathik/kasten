{
  "name": "@kasten-slides/render-page",
  "version": "0.1.0",
  "private": true,
  "description": "The page a headless Chrome or Chromium draws decks with: what `slides render` and the agent tools point the browser at",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5411 --host 127.0.0.1",
    "build": "node ../../scripts/build-render-page.mjs",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node ../../scripts/build-wasm.mjs --if-stale",
    "pretest": "node ../../scripts/build-wasm.mjs --if-stale",
    "test": "vitest run"
  },
  "dependencies": {
    "@kasten-slides/react": "workspace:*",
    "@kasten-slides/wasm": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
